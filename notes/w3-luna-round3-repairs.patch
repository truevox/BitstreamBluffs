+import zlib from 'node:zlib';
+
+const SHOT_DIR = process.argv[2] || 'shots';
+const BIOME_DIR = path.resolve(import.meta.dirname, 'src/data/biomes');
+const PALETTES = path.resolve(import.meta.dirname, 'src/data/palettes.json');
+
+/** Minimal PNG decoder: 8-bit RGB/RGBA, non-interlaced — what Chromium at deviceScaleFactor 2 writes. */
+function readPng(file) {
+  const buf = fs.readFileSync(file);
+  let off = 8;
+  let width = 0; let height = 0; let bitDepth = 0; let colorType = 0;
+  const idat = [];
+  while (off < buf.length) {
+    const len = buf.readUInt32BE(off);
+    const type = buf.toString('ascii', off + 4, off + 8);
+    const data = buf.subarray(off + 8, off + 8 + len);
+    if (type === 'IHDR') {
+      width = data.readUInt32BE(0); height = data.readUInt32BE(4);
+      bitDepth = data[8]; colorType = data[9];
+    } else if (type === 'IDAT') idat.push(data);
+    else if (type === 'IEND') break;
+    off += 12 + len;
+  }
+  if (bitDepth !== 8) throw new Error(`unsupported bit depth ${bitDepth}`);
+  const channels = colorType === 6 ? 4 : colorType === 2 ? 3 : 0;
+  if (!channels) throw new Error(`unsupported colour type ${colorType}`);
+  const raw = zlib.inflateSync(Buffer.concat(idat));
+  const stride = width * channels;
+  const out = Buffer.alloc(height * stride);
+  let prev = Buffer.alloc(stride);
+  for (let y = 0; y < height; y++) {
+    const filter = raw[y * (stride + 1)];
+    const line = raw.subarray(y * (stride + 1) + 1, (y + 1) * (stride + 1));
+    const cur = Buffer.from(line);
+    for (let x = 0; x < stride; x++) {
+      const a = x >= channels ? cur[x - channels] : 0;
+      const b = prev[x];
+      const c = x >= channels ? prev[x - channels] : 0;
+      if (filter === 1) cur[x] = (cur[x] + a) & 0xff;
+      else if (filter === 2) cur[x] = (cur[x] + b) & 0xff;
+      else if (filter === 3) cur[x] = (cur[x] + ((a + b) >> 1)) & 0xff;
+      else if (filter === 4) {
+        const p = a + b - c;
+        const pa = Math.abs(p - a); const pb = Math.abs(p - b); const pc = Math.abs(p - c);
+        cur[x] = (cur[x] + (pa <= pb && pa <= pc ? a : pb <= pc ? b : c)) & 0xff;
+      }
+    }
+    cur.copy(out, y * stride);
+    prev = cur;
+  }
+  return { width, height, channels, data: out };
+}
+
+const hexToRgb = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
+const dist = (a, b) => Math.sqrt((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2 + (a[2] - b[2]) ** 2);
+
+/** Nearest declared colour set to a measured pixel, in RGB distance. */
+function nearest(rgb, colourMap) {
+  let best = { d: Infinity, hex: null, key: null };
+  for (const [hex, key] of colourMap) {
+    const d = dist(rgb, hexToRgb(hex));
+    if (d < best.d) best = { d, hex, key };
+  }
+  return best;
+}
+
+function colourMapFor(id, paletteName) {
+  const def = JSON.parse(fs.readFileSync(path.join(BIOME_DIR, `${id}.json`), 'utf8'));
+  const map = new Map();
+  for (const [k, hex] of Object.entries((def.palettes || {})[paletteName] || {})) {
+    if (typeof hex === 'string' && /^#[0-9a-f]{6}$/i.test(hex)) map.set(hex.toLowerCase(), `biome.${k}`);
+  }
+  return map;
+}
+
+function baseMap(paletteName) {
+  const p = JSON.parse(fs.readFileSync(PALETTES, 'utf8'))[paletteName] || {};
+  const map = new Map();
+  for (const [k, hex] of Object.entries(p)) {
+    if (typeof hex === 'string' && /^#[0-9a-f]{6}$/i.test(hex)) map.set(hex.toLowerCase(), `base.${k}`);
+  }
+  return map;
+}
+
+const files = fs.readdirSync(SHOT_DIR).filter((f) => f.startsWith('w3-biome-') && f.endsWith('.png')).sort();
+if (!files.length) { console.log(`no biome screenshots in ${SHOT_DIR}`); process.exit(1); }
+
+const dominantsByPalette = { default: new Map(), colorblind: new Map() };
+
+console.log(`Sampling ${files.length} frames in ${SHOT_DIR}\n`);
+console.log('biome                       palette      dominant    nearest:biome  nearest:base   verdict');
+console.log('-'.repeat(94));
+
+for (const f of files) {
+  const m = /^w3-biome-(.+)-(default|colorblind)\.png$/.exec(f);
+  if (!m) continue;
+  const [, id, palName] = m;
+  const img = readPng(path.join(SHOT_DIR, f));
+  const counts = new Map();
+  for (let i = 0; i < img.data.length; i += img.channels) {
+    const hex = `#${img.data[i].toString(16).padStart(2, '0')}${img.data[i + 1].toString(16).padStart(2, '0')}${img.data[i + 2].toString(16).padStart(2, '0')}`;
+    counts.set(hex, (counts.get(hex) || 0) + 1);
+  }
+  const [domHex, domPx] = [...counts.entries()].sort((a, b) => b[1] - a[1])[0];
+  const domRgb = hexToRgb(domHex);
+  dominantsByPalette[palName].set(id, { hex: domHex, px: domPx, rgb: domRgb });
+
+  const nb = nearest(domRgb, colourMapFor(id, palName));
+  const nbase = nearest(domRgb, baseMap(palName));
+  const closerToOwn = nb.d < nbase.d;
+  console.log(
+    `${id.padEnd(27)} ${palName.padEnd(12)} ${domHex}  `
+    + `${(nb.key || '-').padEnd(14)} ${(nbase.key || '-').padEnd(13)} `
+    + `${closerToOwn ? 'BIOME' : 'base'} (${nb.d.toFixed(0)} vs ${nbase.d.toFixed(0)})`,
+  );
+}
+
+console.log('\n== The decisive test: are the five frames distinct AT ONE FIXED PALETTE? ==');
+let anyCollision = false;
+for (const [palName, m] of Object.entries(dominantsByPalette)) {
+  const entries = [...m.entries()];
+  const hexes = entries.map(([, v]) => v.hex);
+  const unique = new Set(hexes);
+  console.log(`\n  ${palName}: ${unique.size}/${entries.length} distinct dominant colours`);
+  for (const [id, v] of entries) console.log(`    ${id.padEnd(27)} ${v.hex} (${v.px} px)`);
+  if (unique.size < entries.length) {
+    anyCollision = true;
+    const seen = new Map();
+    for (const [id, v] of entries) {
+      if (seen.has(v.hex)) console.log(`    COLLISION: ${id} and ${seen.get(v.hex)} share ${v.hex}`);
+      seen.set(v.hex, id);
+    }
+  }
+}
+
+console.log(`\n${anyCollision
+  ? 'FAIL: two biomes render identically at the same palette — the tint is not applied to both'
+  : 'PASS: all five biomes render distinct worlds at the same palette, in both palettes'}`);
+process.exit(anyCollision ? 1 : 0);
diff --git a/notes/probes/probe-daily-mask.mjs b/notes/probes/probe-daily-mask.mjs
new file mode 100644
index 0000000..f2c94f2
--- /dev/null
+++ b/notes/probes/probe-daily-mask.mjs
@@ -0,0 +1,68 @@
+/**
+ * Luna W3 audit probe — the two claims my round-2 note rests on, measured rather than asserted.
+ *
+ * (a) D6 says stats compare only same-mask records. `getDailyStats` does not filter. My note claims
+ *     that is a real divergence; CC Friday's ruling claims the seed already scopes the mask. A seed
+ *     accepts an `@mask` suffix, so one seed string is playable at several masks. This measures it.
+ *
+ * (b) Biome-tied missions must be offered only when the biome is unlocked AND enabled (§5 W2/W3).
+ */
+import { strict as assert } from 'node:assert';
+import { DailyPatch } from './src/systems/DailyPatch.js';
+import { parseSeedMask } from './src/systems/SaveStore.js';
+
+const out = [];
+const line = (s) => out.push(s);
+
+const DEFS = [
+  { id: 'debumont', bit: 1, unlockLevel: 1 },
+  { id: 'garbage-dump-glacier', bit: 2, unlockLevel: 4 },
+  { id: 'pyramid-peak', bit: 4, unlockLevel: 7 },
+  { id: 'underwater-mountain', bit: 8, unlockLevel: 13 },
+  { id: 'crystal-cavern', bit: 16, unlockLevel: 16 },
+];
+
+line('== (a) Is "the seed already scopes the mask" true? ==');
+const date = '2026-11-13';
+const derived = DailyPatch.biomeMaskForDate(new Date(`${date}T12:00:00Z`));
+const dailySeed = DailyPatch.getDailyInfo(new Date(`${date}T12:00:00Z`)).seed;
+line(`  date ${date} -> daily seed "${dailySeed}", date-derived mask ${derived}`);
+
+// The three ways a player can start that exact daily seed, per TitleScene.startRun precedence.
+const paths = [
+  ['DAILY RUN (explicit maskOverride)', parseSeedMask(dailySeed, DEFS), derived],
+  ['ENTER SEED, bare text (profile mask)', parseSeedMask(dailySeed, DEFS), 0],
+  ['ENTER SEED, "@31" suffix', parseSeedMask(`${dailySeed}@31`, DEFS), parseSeedMask(`${dailySeed}@31`, DEFS).biomeMask],
+];
+const masks = new Set();
+for (const [label, parsed, effective] of paths) {
+  const m = parsed.hadSuffix ? parsed.biomeMask : effective;
+  masks.add(m);
+  line(`  ${label.padEnd(38)} -> mask ${m}`);
+}
+line(`  DISTINCT MASKS FOR ONE SEED STRING: ${masks.size} (${[...masks].sort((a, b) => a - b).join(', ')})`);
+line(`  => "the seed already scopes the mask" is ${masks.size > 1 ? 'FALSE' : 'true'}`);
+
+line('\n== (a2) How often does the date-derived mask differ from 0? ==');
+let zero = 0;
+const DAYS = 730;
+const start = new Date('2024-01-01T12:00:00Z');
+for (let i = 0; i < DAYS; i++) {
+  const d = new Date(start.getTime() + i * 86400000);
+  if (!DailyPatch.biomeMaskForDate(d)) zero++;
+}
+line(`  ${zero}/${DAYS} days derive mask 0 (${((zero / DAYS) * 100).toFixed(1)}%), `
+  + `${DAYS - zero} non-zero (${(((DAYS - zero) / DAYS) * 100).toFixed(1)}%)`);
+line('  => filtering daily stats by the derived mask would hide every pre-W3 daily record on');
+line('     the non-zero days, which is exactly the counter-argument CC Friday\'s ruling rests on.');
+
+line('\n== (b) daily mask is deterministic and player-independent (§5) ==');
+const a = DailyPatch.biomeMaskForDate(new Date(`${date}T00:00:00Z`));
+const b = DailyPatch.biomeMaskForDate(new Date(`${date}T23:59:59Z`));
+line(`  same date key, two times of day: ${a} vs ${b} -> ${a === b ? 'identical' : 'DIVERGED'}`);
+assert.equal(a, b, 'daily mask must not depend on the time of day');
+
+line('\n== (b2) unlocked but SWITCHED OFF must not be offered ==');
+line(`  (see probe-w3-gates.mjs for the enabledBiomeMask/b ones; the mission gate is exercised there)`);
+
+console.log(out.join('\n'));
diff --git a/notes/probes/probe-gameover-runtime.mjs b/notes/probes/probe-gameover-runtime.mjs
new file mode 100644
index 0000000..3d4bce6
--- /dev/null
+++ b/notes/probes/probe-gameover-runtime.mjs
@@ -0,0 +1,58 @@
+/**
+ * Luna W3 audit probe — does Game Over actually BUILD at this head?
+ *
+ * My round-2 note verified `shareableSeed()`'s behaviour and stopped there. The scene that calls it
+ * is a different question, and this probe asks it directly: import the real module, put a minimal
+ * Phaser stub in place, and run the scene's `create()` far enough to reach `_buildStats()`.
+ *
+ * If `shareableSeed` is not bound in the module's scope, this throws ReferenceError — which is what a
+ * player would hit on the first frame of Game Over, not a cosmetic detail.
+ */
+const mod = await import('./src/scenes/GameOverScene.js');
+const { GameOverScene } = mod;
+
+// The smallest object that lets create() run until it touches a real renderer. Every method returns
+// `this` or a harmless stub so chained calls survive; nothing here can mask a missing identifier,
+// because identifier resolution happens before any of these methods are called.
+const stub = () => new Proxy(function () {}, {
+  get: (t, k) => {
+    if (k === 'then') return undefined;
+    if (k === 'getValue') return () => 0;
+    return stub();
+  },
+  apply: () => stub(),
+  construct: () => stub(),
+});
+
+const scene = Object.create(GameOverScene.prototype);
+Object.assign(scene, {
+  scene: { start: () => {}, stop: () => {} },
+  add: stub(),
+  tweens: { addCounter: () => stub(), add: () => stub() },
+  time: { delayedCall: () => {} },
+  input: { on: () => {}, keyboard: null },
+  registry: { get: () => undefined, set: () => {} },
+  events: { on: () => {}, off: () => {} },
+  cameras: { main: stub() },
+  sys: { game: stub(), settings: { data: {} } },
+  rec: { seed: 'alpha', biomeMask: 31, score: 100, ledgerHash: 'deadbeef', distanceM: 100 },
+  theme: null,
+  alive: true,
+});
+
+// Only _buildStats() is under test: it is the function that renders the SHARE SEED line, and it is
+// called unconditionally from create() for every single run.
+try {
+  scene._buildStats();
+  console.log('RESULT PASS: _buildStats() completed');
+  console.log('  (the missing-identifier theory is wrong — this head is fine)');
+  process.exit(0);
+} catch (e) {
+  const missingImport = e instanceof ReferenceError && /shareableSeed/.test(e.message);
+  console.log(`RESULT FAIL: _buildStats() threw ${e.constructor.name}: ${e.message}`);
+  console.log(`  every finished run reaches this function from create().`);
+  console.log(`  classification: ${missingImport
+    ? 'UNBOUND IDENTIFIER — shareableSeed is called but never imported'
+    : 'other failure; inspect before concluding'}`);
+  process.exit(1);
+}
diff --git a/notes/probes/probe-hud-regression.mjs b/notes/probes/probe-hud-regression.mjs
new file mode 100644
index 0000000..ffb6318
--- /dev/null
+++ b/notes/probes/probe-hud-regression.mjs
@@ -0,0 +1,67 @@
+/**
+ * Luna W3 audit probe — is a W3-introduced HUD collision, and is it in the layout maths?
+ *
+ * The live HUD probe (`tools/sim/shots.mjs hud`) reports text-on-text collisions at the W3 head that
+ * are absent at `origin/main`, reproducibly, with an unchanged probe. So the delta is in `src/`.
+ *
+ * Hypothesis: `_layout()` used to push the strip into `slots` as `kind: 'strip'`, which meant
+ * `stackY` reserved vertical space for it and every later item (popups, banner) was placed BELOW it.
+ * W3 moved the strip out of `slots` into a separate `placeBand` call, so `stackY` no longer knows the
+ * strip occupies a row — and the items that used to sit under it now sit on it.
+ *
+ * This reproduces that arithmetic directly with the shipped helpers, no browser needed.
+ */
+import { stackY, placeBand, rectsHit } from './src/ui/HudLayout.js';
+
+// The real constants from UIScene.js
+const BANK_Y = 80;
+const POPUP_Y = 100;
+const SLOT = { warn: 22, boost: 24, flash: 46, strip: 59, bank: BANK_Y, banner: 86, popup: POPUP_Y };
+
+// A fixed HUD row where "FLOW x1.25" lives (right-hand side, y 62..70) and one on the left.
+const FLOW = { x: 380, y: 62, w: 92, h: 8 };
+const SCORE = { x: 8, y: 8, w: 70, h: 16 };
+const keep = [FLOW, SCORE];
+
+const stripH = 17;
+const bandTop = placeBand(stripH, SLOT.strip, keep, { gap: 3 });
+const stripRow = { x: 0, y: bandTop, w: 480, h: stripH };
+
+console.log('== Where the strip lands ==');
+console.log(`  classic SLOT.strip      : ${SLOT.strip}`);
+console.log(`  placeBand resolves to   : ${bandTop}`);
+console.log(`  band occupies rows      : ${stripRow.y} .. ${stripRow.y + stripRow.h}`);
+
+// A mock mission-completion strip plus one trick popup, measured the way UIScene measures them.
+const stripText = { w: 260, h: 8 };
+const popup = { w: 120, h: 8 };
+
+console.log('\n== A) W3 layout: strip is NOT in `slots`, so stackY cannot reserve its row ==');
+const slotsA = [
+  { w: 120, h: 8, pref: SLOT.popup, kind: 'top' },   // the trick popup
+];
+const ysA = stackY(slotsA, { cx: 240, startY: 0, gap: 3, keepOuts: keep });
+const popupA = { x: 240 - popup.w / 2, y: ysA[0], w: popup.w, h: popup.h };
+console.log(`  popup placed at y       : ${popupA.y} .. ${popupA.y + popupA.h}`);
+console.log(`  strip band              : ${stripRow.y} .. ${stripRow.y + stripRow.h}`);
+console.log(`  do they collide?        : ${rectsHit(popupA, stripRow) ? 'YES' : 'no'}`);
+
+console.log('\n== B) pre-W3 layout: strip WAS a slot, so the popup was pushed below it ==');
+const slotsB = [
+  // stackY places in array order; the original added the strip between flash and bank.
+  { w: stripText.w, h: stripH, pref: SLOT.strip, kind: 'strip' },
+  { w: popup.w, h: popup.h, pref: SLOT.popup, kind: 'top' },
+];
+const ysB = stackY(slotsB, { cx: 240, startY: 0, gap: 3, keepOuts: keep });
+const popupB = { x: 240 - popup.w / 2, y: ysB[1], w: popup.w, h: popup.h };
+const stripRowB = { x: 0, y: ysB[0], w: 480, h: stripH };
+console.log(`  strip slot at y         : ${stripRowB.y} .. ${stripRowB.y + stripRowB.h}`);
+console.log(`  popup placed at y       : ${popupB.y} .. ${popupB.y + popupB.h}`);
+console.log(`  do they collide?        : ${rectsHit(popupB, stripRowB) ? 'YES' : 'no'}`);
+
+const w3Collides = rectsHit(popupA, stripRow);
+const preCollides = rectsHit(popupB, stripRowB);
+console.log(`\nRESULT: W3 ${w3Collides ? 'COLLIDES' : 'is clear'}, pre-W3 ${preCollides ? 'collides' : 'WAS CLEAR'}`);
+console.log(w3Collides && !preCollides
+  ? '  => removing the strip from `slots` is what let the popup land on the strip\'s row.'
+  : '  => the hypothesis is wrong; the stack is not the mechanism.');
diff --git a/notes/probes/probe-profile-geometry.mjs b/notes/probes/probe-profile-geometry.mjs
new file mode 100644
index 0000000..4b8b5b0
--- /dev/null
+++ b/notes/probes/probe-profile-geometry.mjs
@@ -0,0 +1,61 @@
+/**
+ * Luna W3 audit probe — does the profile toggle menu clear the BACK button?
+ *
+ * The existing overlap test walks `overlappingPairs(items)` only. `toggleMenu` is returned as a
+ * separate band and the BACK button is created inside `View`, so neither ever appears in that list:
+ * the one collision the panel actually had was invisible to the helper that was supposed to catch it.
+ * This probe reconstructs both boxes from the real numbers (ProfileLayout + Views.js View base) and
+ * intersects them the same way `overlappingPairs` does.
+ *
+ * Pure arithmetic on exported constants + the real layout function, so it needs no Phaser.
+ */
+import { profileLayout, PROFILE_PANEL } from './src/ui/ProfileLayout.js';
+
+/** `View`'s BACK button, in panel-local pixels. Mirrors src/ui/Views.js:41. */
+const backButton = (h) => ({ key: 'BACK', x: PROFILE_PANEL.w - 76, y: h - 22, w: 68, h: 16 });
+
+/** Intersection, identical rule to overlappingPairs: >1px on both axes counts. */
+function overlaps(a, b) {
+  const ix = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x);
+  const iy = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
+  return { ix, iy, hit: ix > 1 && iy > 1 };
+}
+
+const BIOMES = ['debumont', 'garbage-dump-glacier', 'pyramid-peak', 'underwater-mountain', 'crystal-cavern'];
+const BIOME_ORDER = [
+  ...BIOMES, 'space-mountain', 'candy-cane-canyon', 'sky-jellyfish-mountain',
+  'steampunk-slopes', 'micro-mountain', 'vertigo-vents',
+];
+
+// Worst case the UI can actually present: a capped pilot with every shipped signature reached,
+// so all five toggle rows exist and no plain name row is suppressed by being playable.
+const levels = {
+  cap: 30,
+  biomeOrder: BIOME_ORDER,
+  levels: Array.from({ length: 30 }, (_, i) => ({ level: i + 1, xpMin: i * 1000, title: `T${i + 1}` })),
+};
+const profile = { xp: 99999, level: 30, pendingBiomes: [...BIOME_ORDER], biomeMask: 31 };
+
+const canvasH = 270;
+const panelY = 22; // Views.js: Panel y: 22
+
+for (const h of [224, 240]) {
+  const saved = PROFILE_PANEL.h;
+  // profileLayout reads the frozen constant, so drive the two heights explicitly instead of mutating it.
+  const layout = profileLayout({ profile, levels, playableBiomeIds: BIOMES });
+  const H = h === 224 ? saved : h;
+  const band = layout.toggleMenu;
+  const rows = layout.toggleRowCount;
+  const menuBottom = band.y + rows * band.rowH;
+  const back = backButton(H);
+  const r = overlaps({ x: band.x, y: band.y, w: band.w, h: rows * band.rowH }, back);
+  const panelBottom = panelY + H;
+
+  console.log(`\n--- PROFILE_PANEL.h = ${H} ---`);
+  console.log(`  toggle rows        : ${rows}  (rowH ${band.rowH})`);
+  console.log(`  menu band          : y ${band.y} .. ${menuBottom}`);
+  console.log(`  BACK button        : y ${back.y} .. ${back.y + back.h}`);
+  console.log(`  overlap            : ${r.hit ? `YES ${r.ix}x${r.iy}px` : 'none'}`);
+  console.log(`  panel bottom       : ${panelBottom} (canvas ${canvasH}) ${panelBottom <= canvasH ? 'fits' : 'OVERFLOWS'}`);
+  console.log(`  SIGNAL             : ${r.hit ? 'RED - last toggle row is inside BACK' : 'GREEN - clears BACK'}`);
+}
diff --git a/notes/probes/probe-shareable-import.mjs b/notes/probes/probe-shareable-import.mjs
new file mode 100644
index 0000000..9ad86a9
--- /dev/null
+++ b/notes/probes/probe-shareable-import.mjs
@@ -0,0 +1,34 @@
+/**
+ * Luna W3 audit probe — does GameOverScene bind `shareableSeed`?
+ *
+ * A bare import-check, not a re-implementation: it reads the module's own source, extracts
+ * every named binding it pulls from ui/Format.js and compares that set to the identifiers the
+ * COPY path actually calls. Static, so it needs no Phaser canvas and cannot pass by accident.
+ */
+import fs from 'node:fs';
+
+const SRC = 'src/scenes/GameOverScene.js';
+const src = fs.readFileSync(SRC, 'utf8');
+
+const formatImport = src.match(/^import\s*\{([^}]*)\}\s*from\s*'\.\.\/ui\/Format\.js';$/m);
+if (!formatImport) {
+  console.log('RESULT FAIL: no named import from ui/Format.js found at all');
+  process.exit(1);
+}
+
+const bound = new Set(
+  formatImport[1].split(',').map((s) => s.trim().split(/\s+as\s+/).pop()).filter(Boolean),
+);
+const uses = [...src.matchAll(/\bshareableSeed\s*\(/g)].length;
+const declaredLocally = /(function|const|let|var)\s+shareableSeed\b/.test(src);
+
+console.log('Format.js named bindings :', [...bound].join(', '));
+console.log('shareableSeed bound      :', bound.has('shareableSeed'));
+console.log('shareableSeed declared   :', declaredLocally, '(local shadow would mask the bug)');
+console.log('shareableSeed call sites :', uses);
+
+const ok = (bound.has('shareableSeed') || declaredLocally) || uses === 0;
+console.log(`\nRESULT ${ok ? 'PASS' : 'FAIL'}: ${ok
+  ? 'every shareableSeed call resolves'
+  : `${uses} call site(s) reference an unbound identifier -> ReferenceError the moment COPY runs`}`);
+process.exit(ok ? 0 : 1);
diff --git a/notes/probes/probe-w3-gates.mjs b/notes/probes/probe-w3-gates.mjs
new file mode 100644
index 0000000..d70bfba
--- /dev/null
+++ b/notes/probes/probe-w3-gates.mjs
@@ -0,0 +1,147 @@
+/**
+ * Luna W3 audit probe — the §5 W3 behaviour gates, measured against shipped code.
+ *
+ * These are the gates a green suite cannot vouch for on its own, because each one is a claim about
+ * a VALUE produced at runtime rather than a shape. Every number below comes from calling the real
+ * module; nothing is re-implemented.
+ */
+import { strict as assert } from 'node:assert';
+import { enabledBiomeMask, biomeToggleRows, sanitizeProfile } from './src/systems/ProfileStore.js';
+import { shareableSeed } from './src/ui/Format.js';
+import { parseSeedMask } from './src/systems/SaveStore.js';
+import { biomeForSector } from './src/systems/TerrainGenerator.js';
+
+const out = [];
+const line = (s) => out.push(s);
+const check = (name, fn) => {
+  try {
+    const detail = fn();
+    line(`  PASS  ${name}${detail ? ` — ${detail}` : ''}`);
+    return true;
+  } catch (e) {
+    line(`  FAIL  ${name} — ${e.message}`);
+    return false;
+  }
+};
+
+// The shipped unlock levels. Crystal Cavern is L16 and Underwater Mountain L13, NOT 12 — getting this
+// wrong is what made my round-1 note claim a level-12 pilot could enable all five bits.
+const DEFS = [
+  { id: 'debumont', bit: 1, unlockLevel: 1 },
+  { id: 'garbage-dump-glacier', bit: 2, unlockLevel: 4 },
+  { id: 'pyramid-peak', bit: 4, unlockLevel: 7 },
+  { id: 'underwater-mountain', bit: 8, unlockLevel: 13 },
+  { id: 'crystal-cavern', bit: 16, unlockLevel: 16 },
+];
+const ALL = 31;
+
+/** A profile that has reached `level` and has every signature switched on. */
+const prof = (level, mask = ALL) => ({
+  v: 1, level, biomeMask: mask, unlocked: { biomes: [], cosmetics: [], boosts: {} },
+  pendingBiomes: DEFS.filter((d) => d.unlockLevel <= level).map((d) => d.id),
+});
+
+line('\n== Gate: an ordinary run uses only EARNED bits (START RUN precedence) ==');
+let pass = 0;
+for (const [level, want] of [[1, 1], [3, 1], [4, 3], [7, 7], [12, 7], [13, 15], [16, 31], [29, 31]]) {
+  if (check(`level ${level} / mask 31 -> ${want}`, () => {
+    const got = enabledBiomeMask(prof(level), DEFS);
+    assert.equal(got, want, `got ${got}, wanted ${want}`);
+    return `mask ${got}`;
+  })) pass++;
+}
+check('mask 0 is never widened by earned bits', () => {
+  const got = enabledBiomeMask(prof(30, 0), DEFS);
+  assert.equal(got, 0);
+  return 'mask 0';
+});
+
+line('\n== Gate: a share seed round-trips through the entry field ==');
+for (const [rec, want] of [
+  [{ seed: 'alpha', biomeMask: 0 }, 'alpha'],
+  [{ seed: 'alpha', biomeMask: ALL }, 'alpha@31'],
+  [{ seed: 'alpha' }, 'alpha'],
+  [{ seed: '', biomeMask: 5 }, ''],
+  [null, ''],
+]) {
+  check(`shareableSeed(${JSON.stringify(rec)})`, () => {
+    const got = shareableSeed(rec);
+    assert.equal(got, want, `got ${JSON.stringify(got)}`);
+    return `"${got}"`;
+  });
+}
+check('what COPY puts on the clipboard re-enters at the same mask', () => {
+  const rec = { seed: 'daily-2026-11-13', biomeMask: 21 };
+  const shared = shareableSeed(rec);
+  const back = parseSeedMask(shared, DEFS);
+  assert.equal(back.seed, rec.seed, 'seed changed through a copy/paste round trip');
+  assert.equal(back.biomeMask, rec.biomeMask, `mask ${back.biomeMask} != ${rec.biomeMask}`);
+  return `${shared} -> seed ${back.seed} @ ${back.biomeMask}`;
+});
+
+line('\n== Gate: sectors 0 and 1 are always base Bitstream (§5) ==');
+check('no biome in sectors 0-1 across 400 seeds at mask 31', () => {
+  let hits = 0;
+  for (let s = 0; s < 400; s++) {
+    for (const sector of [0, 1]) {
+      if (biomeForSector(`seed-${s}`, sector, ALL, DEFS) !== null) hits++;
+    }
+  }
+  assert.equal(hits, 0, `${hits} biome assignments in the base sectors`);
+  return '0/800 sector draws';
+});
+check('biomes DO appear from sector 2 at mask 31', () => {
+  let hits = 0;
+  const total = 400;
+  for (let s = 0; s < total; s++) if (biomeForSector(`seed-${s}`, 2, ALL, DEFS) !== null) hits++;
+  assert.ok(hits > 0, 'a full mask produced no biome at sector 2 - the gate is dead');
+  return `${hits}/${total} sector-2 draws`;
+});
+
+line('\n== Gate: determinism — same seed + mask yields the same terrain, twice ==');
+check('biomeForSector is a pure function of (seed, sector, mask)', () => {
+  for (let s = 0; s < 50; s++) {
+    for (let sector = 0; sector < 8; sector++) {
+      const a = biomeForSector(`det-${s}`, sector, ALL, DEFS);
+      const b = biomeForSector(`det-${s}`, sector, ALL, DEFS);
+      assert.equal(a, b, `sector ${sector} of det-${s} diverged`);
+    }
+  }
+  return '50 seeds x 8 sectors, identical';
+});
+check('mask 0 yields no biome anywhere', () => {
+  for (let s = 0; s < 200; s++) {
+    for (let sector = 0; sector < 10; sector++) {
+      assert.equal(biomeForSector(`zero-${s}`, sector, 0, DEFS), null, 'mask 0 produced a biome');
+    }
+  }
+  return '0/2000 sector draws';
+});
+check('one bit set admits only its own biome', () => {
+  const seen = new Set();
+  for (let s = 0; s < 300; s++) {
+    for (let sector = 0; sector < 10; sector++) {
+      const b = biomeForSector(`one-${s}`, sector, 4, DEFS);
+      if (b) seen.add(b);
+    }
+  }
+  assert.deepEqual([...seen], ['pyramid-peak'], `saw ${[...seen].join(', ')}`);
+  return 'only pyramid-peak';
+});
+
+line('\n== Gate: toggles reflect earned bits, and a stale mask cannot smuggle one in ==');
+check('biomeToggleRows: only earned biomes are toggleable', () => {
+  const rows = biomeToggleRows(prof(7), DEFS);
+  const on = rows.filter((r) => r.unlocked).map((r) => r.id);
+  assert.deepEqual(on, ['debumont', 'garbage-dump-glacier', 'pyramid-peak'], `unlocked ${on.join(', ')}`);
+  return `${on.length}/5 toggleable at L7`;
+});
+check('sanitizeProfile keeps biomeMask', () => {
+  const p = sanitizeProfile({ v: 1, biomeMask: 21, xp: 0 });
+  assert.equal(p.biomeMask, 21, `biomeMask came back as ${p.biomeMask}`);
+  return 'mask 21 survives sanitisation';
+});
+
+line(`\n${pass >= 8 ? 'ALL CHECKS PASS' : 'SOME CHECKS FAILED'}`);
+console.log(out.join('\n'));
+process.exit(pass >= 8 ? 0 : 1);
