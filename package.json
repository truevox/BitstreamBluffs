{
  "name": "bitstream-bluffs",
  "version": "2.25.35",
  "type": "module",
  "description": "2D side-scrolling infinite sledder game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sim": "node tools/sim/run.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:puppeteer": "node ./node_modules/mocha/bin/mocha.js tests/puppeteer-tests.js --timeout 30000",
    "test:all": "npm run test && npm run test:puppeteer",
    "gate:heavy": "node tools/savestate-experiment/run-heavy-gate.mjs",
    "gate:playthrough": "npm run build && node tools/sim/gate-playthrough.mjs --with-boosts"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 10000,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "devDependencies": {
    "@babel/parser": "7.27.2",
    "@stdlib/math-base-special-acos": "0.2.4",
    "@stdlib/math-base-special-asin": "0.2.4",
    "@stdlib/math-base-special-atan": "0.2.4",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cbrt": "0.2.3",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-cosh": "0.2.4",
    "@stdlib/math-base-special-exp": "0.2.5",
    "@stdlib/math-base-special-expm1": "0.2.4",
    "@stdlib/math-base-special-hypot": "0.2.4",
    "@stdlib/math-base-special-ln": "0.2.5",
    "@stdlib/math-base-special-log10": "0.3.1",
    "@stdlib/math-base-special-log1p": "0.2.4",
    "@stdlib/math-base-special-log2": "0.3.1",
    "@stdlib/math-base-special-pow": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "@stdlib/math-base-special-sinh": "0.2.4",
    "@stdlib/math-base-special-tan": "0.3.1",
    "@stdlib/math-base-special-tanh": "0.2.4",
    "chai": "^5.2.0",
    "esbuild": "0.25.4",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mocha": "^11.5.0",
    "netlify-plugin-cache": "^1.0.3",
    "phaser": "3.90.0",
    "phaser3spectorjs": "^0.0.8",
    "playwright": "^1.65.0",
    "puppeteer": "^24.9.0",
    "vite": "^6.3.5"
  }
}
