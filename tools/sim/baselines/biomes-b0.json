{
 "about": "Sim baseline for the biome full treatment: the +/-15 % tolerance reference for B1-B4, refreshed for #65 (Debutmont base biome + arcade bridges). `reference` is the sim on the #65 gameplay branch. `beforeIssue65` is the same commands on the #65 rename head (abf738c, terrain identical to main 0c8c6c1), and `issue65Delta` is reference vs beforeIssue65. `b0Reference` (the B0 branch after E7, no biome content), `beforeE7` (8db8dee) and `e7Delta` are the original B0 numbers, kept for history; they predate B1-B4 tuning and the later hazard changes, so `beforeIssue65`, not `b0Reference`, is the like-for-like comparison.",
 "commands": {
  "hop": "node tools/sim/run.mjs --seeds 48 --policy hop --maxM 5000 --maxSec 300 --biomeMask <M> --workers 8 --quiet --out hop-m<M>.json",
  "flip": "node tools/sim/run.mjs --seeds 24 --policy flip --maxM 5000 --maxSec 300 --biomeMask <M> --workers 8 --quiet --out flip-m<M>.json",
  "handsOff": "node tools/sim/run.mjs --seeds 24 --policy handsOff --maxM 5000 --maxSec 300 --biomeMask <M> --workers 8 --quiet"
 },
 "metrics": {
  "survived": "runs ending on maxM or maxSec (reached 5000 m without a crash)",
  "survivalRate": "survived / runs",
  "meanDistM": "mean of results[].distM",
  "meanSpeedPxS": "mean over runs of distM * 20 / simSec (PIXELS_PER_METER = 20), i.e. average speed of the whole run",
  "medianMaxSpeedPxS": "summary.maxSpeed.median from run.mjs"
 },
 "biomes": {
  "0": "base (mask 0): Debutmont since #65 (mask 0 and mask 1 are the same terrain)",
  "1": "debutmont (the base biome since #65: same terrain as mask 0)",
  "2": "garbage-dump-glacier",
  "4": "pyramid-peak",
  "8": "underwater-mountain",
  "16": "crystal-cavern",
  "32": "space-mountain",
  "64": "candy-cane-canyon",
  "128": "sky-jellyfish-mountain",
  "256": "steampunk-slopes",
  "512": "micro-mountain",
  "1024": "vertigo-vents"
 },
